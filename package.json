{
  "name": "rede-solidaria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App Rede Solidária WEG — protótipo (PWA web + celular)",
  "scripts": {
    "dev": "vite",
    "celular": "vite --host",
    "build": "tsc -b && vite build",
    "build:arquivo": "tsc -b && vite build --mode arquivo && node scripts/renomear-arquivo.mjs",
    "preview": "vite preview",
    "test": "vitest run && playwright test",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.12",
    "three": "^0.180.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
